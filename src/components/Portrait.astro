---
import { Image } from 'astro:assets';
import portrait from '@/assets/scott-portrait.png';
import { profile } from '@/data/profile';

interface Props {
  size?: 'md' | 'lg';
  /** Set for above-the-fold usage so the image is fetched eagerly. */
  priority?: boolean;
}

const { size = 'md', priority = false } = Astro.props;

const variants = {
  md: { widths: [136, 272], sizes: '136px' },
  lg: { widths: [360, 400], sizes: '(min-width: 400px) 360px, 100vw' },
} as const;
const { widths, sizes } = variants[size];
---

<div class:list={['portrait', `portrait--${size}`]}>
  <Image
    src={portrait}
    alt={`Portrait of ${profile.name}`}
    widths={[...widths]}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
  />
</div>

<style>
  .portrait {
    flex: none;
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    background: oklch(0.2 0.03 285);
  }

  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .portrait--md {
    width: clamp(108px, 22vw, 136px);
    box-shadow:
      0 0 0 3px var(--color-bg),
      0 0 0 5px oklch(0.8 0.14 330 / 0.85),
      0 18px 40px -10px oklch(0.55 0.2 330 / 0.7);
  }

  .portrait--lg {
    justify-self: center;
    width: min(100%, 360px);
    box-shadow:
      0 0 0 4px var(--color-bg),
      0 0 0 6px oklch(0.8 0.14 330 / 0.85),
      0 40px 80px -30px oklch(0.55 0.2 330 / 0.7);
  }
</style>
