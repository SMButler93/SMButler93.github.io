---
import GlassCard from '@/components/GlassCard.astro';
import PageHeading from '@/components/PageHeading.astro';
import { pressMentions, roles } from '@/data/experience';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatTenure, formatYearMonth } from '@/lib/dates';
---

<BaseLayout
  title="Experience"
  description="Professional experience building .NET APIs and services."
>
  <div class="experience">
    <PageHeading eyebrow="Experience" title="Where I've been shipping." />

    {
      roles.map((role) => (
        <article class="role" aria-labelledby={`role-${role.company.toLowerCase()}`}>
          <header class="role__header">
            <div class="role__titles">
              <h2 id={`role-${role.company.toLowerCase()}`} class="role__title">
                {role.title}
              </h2>
              <p class="role__company">{role.company}</p>
              <p class="role__team">{role.team}</p>
            </div>
            <div class="role__meta">
              <p class="role__dates mono">
                <time datetime={role.startDate}>{formatYearMonth(role.startDate)}</time> –{' '}
                {role.endDate ? (
                  <time datetime={role.endDate}>{formatYearMonth(role.endDate)}</time>
                ) : (
                  'Present'
                )}
              </p>
              {!role.endDate && (
                <p class="role__tenure mono">
                  <span class="role__live" aria-hidden="true" />
                  <span data-duration-since={role.startDate}>{formatTenure(role.startDate)}</span>
                </p>
              )}
            </div>
          </header>

          <ol class="highlights">
            {role.highlights.map((highlight) => (
              <li>{highlight}</li>
            ))}
          </ol>
        </article>
      ))
    }

    {
      pressMentions.map((mention) => (
        <GlassCard href={mention.url} external accent="gold" class="press">
          <span class="press__body">
            <span class="eyebrow" data-tone="gold">
              In the news · {mention.publisher}, {formatYearMonth(mention.publishedOn)}
            </span>
            <span class="card-title">{mention.title}</span>
            <span class="card-text">{mention.summary}</span>
          </span>
          <span class="press__arrow" aria-hidden="true">
            ↗
          </span>
          <span class="visually-hidden">(opens in a new tab)</span>
        </GlassCard>
      ))
    }
  </div>
</BaseLayout>

<style>
  .experience {
    display: flex;
    flex-direction: column;
    gap: 32px;
    max-width: 880px;
    padding-top: 16px;
  }

  .role {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: clamp(20px, 4vw, 32px);
    border-radius: var(--radius-xl);
    background: oklch(0.2 0.03 285 / 0.5);
    border: 1px solid oklch(1 0 0 / 0.12);
    -webkit-backdrop-filter: blur(22px) saturate(150%);
    backdrop-filter: blur(22px) saturate(150%);
    box-shadow: 0 30px 60px -28px oklch(0 0 0 / 0.7);
  }

  .role__header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px 24px;
  }

  .role__titles {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .role__title {
    font: 700 clamp(1.375rem, 3.4vw, 1.75rem) / 1.15 var(--font-display);
  }

  .role__company {
    font-weight: 500;
    color: var(--color-pink);
  }

  .role__team {
    font-size: 0.9375rem;
    color: var(--color-text-subtle);
  }

  .role__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .role__dates {
    padding: 9px 12px;
    border-radius: var(--radius-sm);
    background: var(--glass-fill-raised);
    border: 1px solid oklch(1 0 0 / 0.12);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1;
  }

  .role__tenure {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8125rem;
    line-height: 1;
    color: var(--color-text-subtle);
  }

  .role__live {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-success);
    box-shadow: 0 0 10px var(--color-success);
  }

  .highlights {
    counter-reset: highlight;
    display: grid;
    padding: 0;
    list-style: none;
  }

  .highlights li {
    counter-increment: highlight;
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 10px;
    padding-block: 12px;
    border-top: 1px solid oklch(1 0 0 / 0.08);
    color: oklch(0.88 0.02 285);
    line-height: 1.55;
    text-wrap: pretty;
  }

  .highlights li::before {
    content: counter(highlight, decimal-leading-zero);
    font: 500 0.8125rem/1.9 var(--font-mono);
    color: var(--color-blue);
  }

  /* Applied to the GlassCard root; scoped under .experience to outrank GlassCard's own styles. */
  .experience :global(.press) {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .press__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .press__arrow {
    flex: none;
    font: 500 1.25rem/1 var(--font-mono);
    color: var(--color-gold);
  }
</style>
