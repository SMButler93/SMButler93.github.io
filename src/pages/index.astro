---
import ButtonLink from '@/components/ButtonLink.astro';
import Chip from '@/components/Chip.astro';
import GlassCard from '@/components/GlassCard.astro';
import HeroConsole from '@/components/HeroConsole.astro';
import Portrait from '@/components/Portrait.astro';
import { focusAreas } from '@/data/code-samples';
import { currentRole } from '@/data/experience';
import { profile, socialLinks } from '@/data/profile';
import { stackHighlights } from '@/data/skills';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatTenure } from '@/lib/dates';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  url: Astro.site?.href,
  email: `mailto:${profile.email}`,
  worksFor: { '@type': 'Organization', name: currentRole.company },
  sameAs: socialLinks.map((link) => link.url),
};
---

<BaseLayout>
  <script
    type="application/ld+json"
    slot="head"
    is:inline
    set:html={JSON.stringify(personSchema)}
  />

  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__intro">
      <div class="identity">
        <Portrait priority />
        <div class="identity__text">
          <p class="identity__name">{profile.name}</p>
          <p class="identity__role mono">{profile.role}</p>
        </div>
      </div>

      <h1 id="hero-title" class="display-1">
        {profile.headline}
        <span class="accent-text">{profile.headlineAccent}</span>
      </h1>
      <p class="lead">{profile.summary}</p>

      <div class="hero__actions">
        <ButtonLink href="/experience/">See my experience</ButtonLink>
        <ButtonLink href="/contact/" variant="ghost">Get in touch</ButtonLink>
      </div>
    </div>

    <HeroConsole />
  </section>

  <section class="glance" aria-label="At a glance">
    <GlassCard href="/experience/" accent="pink">
      <span class="eyebrow">Now</span>
      <span class="card-title">{currentRole.title} at {currentRole.company}</span>
      <span class="card-text">
        {currentRole.team}.
        <span data-duration-since={currentRole.startDate}
          >{formatTenure(currentRole.startDate)}</span
        >.
      </span>
    </GlassCard>

    <GlassCard href="/about/" accent="blue">
      <span class="eyebrow" data-tone="blue">Focus</span>
      <span class="card-title">{focusAreas.title}</span>
      <span class="card-text">{focusAreas.description}</span>
    </GlassCard>

    <GlassCard href="/skills/" accent="gold">
      <span class="eyebrow" data-tone="gold">Stack</span>
      <span class="chips">
        {stackHighlights.map((skill) => <Chip size="sm">{skill}</Chip>)}
      </span>
    </GlassCard>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr));
    align-items: center;
    gap: 40px 56px;
    padding-block: 24px 56px;
  }

  .hero__intro {
    display: flex;
    flex-direction: column;
    gap: 26px;
  }

  .identity {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .identity__text {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .identity__name {
    font: 600 clamp(1.1875rem, 3vw, 1.375rem) / 1.2 var(--font-sans);
  }

  .identity__role {
    font-size: 0.875rem;
    line-height: 1.3;
    color: var(--color-text-subtle);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .glance {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 16px;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
</style>
